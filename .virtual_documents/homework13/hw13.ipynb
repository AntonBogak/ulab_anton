import numpy as np
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp





g = 9.81
l = 1





def pendulum(t, y):
    theta, omega = y 
    dtheta_dt = omega
    domega_dt = -(g / l) * np.sin(theta)
    return [dtheta_dt, domega_dt]





theta_0 = np.radians(10) # Convert 10 degrees to radians
omega_0 = 0.0 # Initial angular velocity





t_span = (0,10)
t_eval = np.linspace(0, 10, 10)
solution = solve_ivp(pendulum, t_span, [theta_0, omega_0], t_eval=t_eval)
print(solution)





theta_values = solution.y[0]
time_values = solution.t





period = 2*np.pi*np.sqrt(l / g)





print(f"{period:.2g}")






zero_crossings = np.where(np.diff(np.sign(theta_values)))[0]
if len(zero_crossings) >= 2:
    T_numerical = 2 * (time_values[zero_crossings[1]] - time_values[zero_crossings[0]])
else:
    T_numerical = None





plt.plot(time_values, theta_values, label=r'$\theta$ (radians)')

# Add a horizontal line at theta = 0
plt.axhline(0, color='black', linestyle='--', linewidth=1)

# Labels and title
plt.xlabel("Time (s)")
plt.ylabel("Theta (radians)")
plt.title("Pendulum Motion Over Time")
plt.legend()
plt.grid()
plt.show()





print(f"{T_numerical:4g}")





#The approximation was slightly less than the numerical calculation, but matched decently well.





import pandas as pd





url = "https://covid.ourworldindata.org/data/owid-covid-data.csv"





df = pd.read_csv("owid-covid-data.csv")
print(df)





df_country = df[df["location"] == "United States"]





df_country = df_country[["date", "total_cases"]].dropna()





df_country["days_since_start"] = (range(len(df_country)))





print(df_country.head())





from scipy.optimize import curve_fit





def exponential_growth(t,C_0,r):
    return C_0*np.exp(r*t)





days = df_country["days_since_start"].head(30)
cases = df_country["total_cases"].head(30)





p0 = [1,0.1]
popt, blank = curve_fit(exponential_growth, days, cases, p0=p0)
print(popt)





C0_fit, r_fit = popt[0], popt[1]






print(f"{C0_fit:2g}")
print(f"{r_fit:4g}")





future_days = np.arange(0,61)





predicted_cases = exponential_growth(future_days, C0_fit, r_fit)





plt.scatter(days, cases, color='red', label='Actual Cases')
plt.plot(future_days, predicted_cases, color='blue', label='Predicted Cases')
plt.xlabel("Days")
plt.ylabel("Number of Cases")
plt.title("Actual vs. Predicted Growth of Cases")
plt.legend()
plt.show()





# It looks like it fits it fairly well





future_90 = np.arange(0,91)
predicted_cases = exponential_growth(future_90, C0_fit, r_fit)
plt.scatter(days, cases, color='red', label='Actual Cases')
plt.plot(future_90, predicted_cases, color='blue', label='Predicted Cases')

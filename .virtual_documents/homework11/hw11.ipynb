print(Orbital_Period(planet_b))
print(Orbital_Period(planet_c))





import numpy as np





# Once, since once you import and run the module it's there.





def OP_Rewrite(a):
    T = np.array(a)**1/3
    return T






import time





start_time1 = time.perf_counter()
Orbital_Period(5)
end_time1 = time.perf_counter()
print(start_time1 - end_time1)

start_time2 = time.perf_counter()
OP_Rewrite(5)
end_time2 = time.perf_counter()
print(start_time2 - end_time2)






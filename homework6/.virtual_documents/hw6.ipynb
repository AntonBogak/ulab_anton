# Your code here for 2.2
def print_planets_min_distance(planet_data):
    # Convert dictionary items to list
    planets = list(planet_data.items())
    i = 0  # Initialize the index
    while i < len(planets):
        planet, distance = planets[i]  # Get current planet and distance
        if distance >= 5:  # Check if the distance is at least 5 AU
            print(f"{planet}: {distance} AU from the Sun") #Print using that special format
        i += 1  # Move to the next planet
print_planets_min_distance(planet_data)








# Your code here for 3.1
def apparent_magnitude(magnitudes):
    brightlist = [] #Initializes a list
    total_brightness = 0
    for mag in magnitudes:
        brightness = 10**(-mag / 2.5) #Conducts the calculation
        brightlist.append(brightness) #Adds calculated values to the list
    for i in brightlist:
        total_brightness += i #Sums all the brightnesses
    return total_brightness, brightlist

magnitudes = [12.5, 13.2, 14.8, 19.1, 21.0, 18.5, 15.3, 10.5, 23.0]

apparent_magnitude(magnitudes)






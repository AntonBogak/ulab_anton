#first error is an invalid decimal literal, which means a decimal is after a string. Other things are accepting strings and lists as inputs instead of indivdual inputs.
def quadratic(a,b,c):
    pos = (-b + ((b**2)-4*a*c)**(0.5)) / (2*a) # -b + yada yada part of the formula
    neg = (-b - ((b**2)-4*a*c)**(0.5)) / (2*a) # -b - yada yada part of the formula
    return pos, neg
print(quadratic(2,-5,3))
print(quadratic(1,2,3))







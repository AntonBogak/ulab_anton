# this question is practically incomprehensible so im using the assumption that the time limit is 500 and that im inputting the magnitude values
def time_until_limit(magnitudes, time_limit=1.0):
    total_time = 0
    count = 0
    
    for mag in magnitudes:
        if mag >= 20:
            continue #Skips if greater than or equal to 20
        observation_time = 1 / mag # Calculates observation time
        
        if total_time + observation_time <= time_limit:
            total_time += observation_time # Adds observationtime to total time
            count += 1 # Increases count for seconds
        else:
            break 

    return count, total_time

magnitudes = [12.5, 13.2, 14.8, 19.1, 21.0, 18.5, 15.3, 10.5, 23.0]
time_limit = 500
result = time_until_limit(magnitudes, time_limit)
print(result)
        
        
        





